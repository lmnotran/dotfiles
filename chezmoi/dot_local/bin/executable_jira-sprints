#!/usr/bin/env python3
"""jira-sprints — list a Jira board's own sprints.

Usage:
    jira-sprints BOARD [--state active,future,closed] [--json]

Default output: ID | state | name | start to end, one sprint a line.
--json prints the sprints array as Jira's agile API returns each one.
--state keeps sprints in those states (default: all three).

The agile API also lists other boards' sprints that hold the board's issues, and
answers 50 sprints a page. This pages through them all and keeps only the ones
whose originBoardId is BOARD, in the order Jira gives them.
Auth via ~/.netrc (`machine <your-site>.atlassian.net`); uses `curl -n`.
The site comes from JIRA_BASE_URL, in the environment or ~/.config/jira/env.
"""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Final
from urllib.parse import urlencode


def jira_config(name: str, default: str = "") -> str:
    """A setting from the environment, else from ~/.config/jira/env (KEY=value lines)."""
    if os.environ.get(name):
        return os.environ[name]
    path = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "jira" / "env"
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return default
    for line in lines:
        key, sep, value = line.strip().partition("=")
        if sep and key.strip() == name:
            return value.strip().strip("\"'")
    return default


BASE: Final = jira_config("JIRA_BASE_URL").rstrip("/")
STATES: Final = ("active", "future", "closed")
# The most sprints the agile API answers in one page.
PAGE: Final = 50


def states(text: str) -> list[str]:
    """The states in a comma-separated list, each one Jira knows."""
    picked = [part.strip() for part in text.split(",") if part.strip()]
    unknown = [part for part in picked if part not in STATES]
    if unknown or not picked:
        raise argparse.ArgumentTypeError(f"states are {', '.join(STATES)}, comma-separated, not {text!r}")
    return picked


def page(board: int, state: list[str], start: int) -> dict:
    """One page of the board's sprints, from START."""
    params = {"startAt": str(start), "maxResults": str(PAGE), "state": ",".join(state)}
    endpoint = f"{BASE}/rest/agile/1.0/board/{board}/sprint?{urlencode(params)}"
    out = subprocess.run(
        ["curl", "-n", "-sS", "--connect-timeout", "10", "--max-time", "60",
         "-X", "GET", "-H", "Accept: application/json", "-w", "\n%{http_code}", endpoint],
        capture_output=True, text=True,
    )
    if out.returncode:
        sys.exit(f"curl failed ({out.returncode}): {out.stderr}")
    body, _, code = out.stdout.rpartition("\n")
    if code != "200":
        sys.exit(f"HTTP {code}\n{body}")
    try:
        found = json.loads(body)
    except json.JSONDecodeError:
        sys.exit(f"HTTP {code}: non-JSON response\n{body}")
    if not (isinstance(found, dict) and isinstance(found.get("values"), list)):
        sys.exit(f"HTTP {code}: missing values array\n{body}")
    return found


def sprints(board: int, state: list[str]) -> list[dict]:
    """Every sprint of the board's own, across as many pages as Jira has."""
    found: list[dict] = []
    start = 0
    while True:
        answer = page(board, state, start)
        values = answer["values"]
        found += [sprint for sprint in values if isinstance(sprint, dict) and sprint.get("originBoardId") == board]
        if answer.get("isLast") is not False or not values:
            return found
        start += len(values)


def day(stamp: object) -> str:
    """The date part of one of Jira's ISO times, or - when there's none."""
    return stamp[:10] if isinstance(stamp, str) and stamp else "-"


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("board", type=int, help="the board's id, as in .../boards/<id> in its URL")
    ap.add_argument("--state", type=states, default=list(STATES), help="active, future or closed, comma-separated")
    ap.add_argument("--json", action="store_true", help="print the sprints as JSON")
    args = ap.parse_args()
    if not BASE:
        sys.exit("jira-sprints: set JIRA_BASE_URL in the environment or in ~/.config/jira/env")
    if args.board < 1:
        ap.error("the board's id is a positive number")
    found = sprints(args.board, args.state)
    if args.json:
        print(json.dumps(found, indent=2, ensure_ascii=False))
        return
    for sprint in found:
        name = " ".join(str(sprint.get("name", "")).splitlines())
        print(f"{sprint.get('id')} | {sprint.get('state', '')} | {name} | "
              f"{day(sprint.get('startDate'))} to {day(sprint.get('endDate'))}")


if __name__ == "__main__":
    main()
