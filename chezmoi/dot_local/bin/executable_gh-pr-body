#!/usr/bin/env python3
"""gh-pr-body — read / edit a PR body, optionally by section.

Usage:
    gh-pr-body <num>                          # dump full body to stdout
    gh-pr-body <num> --section "## Test plan" # dump just that section
    gh-pr-body <num> --edit-file body.md      # replace whole body from file
    gh-pr-body <num> --section "## Test plan" --edit-file plan.md
                                              # replace just that section
    gh-pr-body <num> -                        # read replacement body from stdin
    gh-pr-body <num> --section "## X" -
    gh-pr-body <num> -R OWNER/REPO ...        # outside a checkout
    gh-pr-body https://github.com/OWNER/REPO/pull/<num> ...
    gh-pr-body <num> --edit-file body.md --no-lint
                                              # skip the prose check

Prose check:
- Before pushing, the replacement text goes through `prose-lint` (em dashes,
  semicolons, "~−", backticked SHAs, "atlOrigin=" links). Lines the PR body
  already had are skipped, so only new or changed text is checked.
- Any finding stops the edit. Fix it, or pass --no-lint for text you didn't
  write. Without `prose-lint` next to this script, the check is skipped
  with a note.

Section semantics:
- A "section" starts at a markdown heading line that matches --section
  exactly (e.g. "## Test plan") and ends at the next heading of the same
  or shallower depth, or the start of the trailing footer, or EOF.
- On replace, the new content overwrites the section *contents* but the
  heading line itself is preserved (unless the replacement begins with a
  heading line, in which case it's used as-is).

Footer handling:
- The footer is the trailing run of blank lines, markdown link-reference
  definitions ("[P11F-XXXX]: https://...?atlOrigin=...", auto-appended by
  the GitHub <-> Jira integration to power smart-link unfurling), and the
  standalone issue link P11 PR bodies carry at the bottom
  ("[P11F-XXXX](https://...)").
- It is split off before any section math and re-attached afterwards, so
  editing the *last* section no longer swallows it. A replacement that
  carries its own footer wins over the fetched one.

PRs are looked up via `gh pr view <num> --json body`; edits go through
`gh pr edit <num> -F <tmpfile>`. Every write is re-fetched and compared
against what was sent, so a no-op or partial push fails loudly instead of
reporting success. The repository comes from the PR URL, -R (exported as
GH_REPO for gh), an existing GH_REPO, or the current checkout.
"""
import argparse
import difflib
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

_PR_URL_RE = re.compile(r"^https://github\.com/[^/\s]+/[^/\s]+/pull/\d+/?$")


def pr_ref(value):
    """PR number as int, or a GitHub PR URL passed through to gh unchanged."""
    if value.isdigit():
        return int(value)
    if _PR_URL_RE.match(value):
        return value.rstrip("/")
    raise argparse.ArgumentTypeError(f"not a PR number or GitHub PR URL: {value!r}")


def fetch_body(num):
    out = subprocess.check_output(
        ["gh", "pr", "view", str(num), "--json", "body", "--jq", ".body"],
        text=True,
    )
    return out.rstrip("\n")


def normalize(body):
    """Canonical form for comparing a pushed body against the live one.

    GitHub returns bodies with CRLF line endings and may drop trailing
    whitespace, so compare on LF with per-line right-trim.
    """
    text = body.replace("\r\n", "\n").replace("\r", "\n")
    return "\n".join(line.rstrip() for line in text.split("\n")).strip()


def verify_body(num, expected):
    live = fetch_body(num)
    if normalize(live) == normalize(expected):
        return
    diff = list(difflib.unified_diff(
        normalize(expected).splitlines(),
        normalize(live).splitlines(),
        fromfile="pushed", tofile="live", lineterm="", n=1,
    ))
    sys.exit(
        f"verify failed: PR #{num} body does not match what was pushed\n"
        + "\n".join(diff[:40])
    )


def push_body(num, body):
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as tf:
        tf.write(body)
        path = tf.name
    subprocess.check_call(["gh", "pr", "edit", str(num), "-F", path])
    verify_body(num, body)


def heading_depth(line):
    m = re.match(r"^(#{1,6})\s", line)
    return len(m.group(1)) if m else None


# Markdown link-reference definition, e.g. "[P11F-1234]: https://...?atlOrigin=..."
_REF_DEF_RE = re.compile(r"^\[[^\]]+\]:\s*\S+")
# Standalone issue link, e.g. "[P11F-1234](https://cpl-legogroup.atlassian.net/...)"
_ISSUE_LINK_RE = re.compile(r"^\[[A-Z][A-Z0-9]*-\d+\]\(https?://\S+\)$")


def is_footer_line(line):
    s = line.strip()
    return bool(_REF_DEF_RE.match(s) or _ISSUE_LINK_RE.match(s))


def split_footer(body):
    """Split the trailing Jira-link footer off a PR body.

    Returns (body_without_footer, footer); footer is "" when the body has
    none. Walks backwards over blank lines and footer lines, stopping at the
    first line that is neither.
    """
    lines = body.splitlines()
    cut = len(lines)
    found = False
    for i in range(len(lines) - 1, -1, -1):
        if not lines[i].strip():
            continue
        if is_footer_line(lines[i]):
            cut = i
            found = True
            continue
        break
    if not found:
        return body, ""
    return "\n".join(lines[:cut]).rstrip(), "\n".join(lines[cut:]).strip()


def join_footer(body, footer):
    body = body.rstrip()
    if not footer:
        return body + "\n"
    return body + "\n\n" + footer.rstrip() + "\n"


def find_section(body, heading):
    lines = body.splitlines()
    start = None
    target_depth = None
    for i, line in enumerate(lines):
        if line.rstrip() == heading.rstrip():
            start = i
            target_depth = heading_depth(line)
            break
    if start is None:
        sys.exit(f"section not found: {heading!r}")
    end = len(lines)
    for j in range(start + 1, len(lines)):
        d = heading_depth(lines[j])
        if d is not None and d <= target_depth:
            end = j
            break
    return start, end, lines


def extract_section(body, heading):
    start, end, lines = find_section(body, heading)
    return "\n".join(lines[start:end]).rstrip() + "\n"


def replace_section(body, heading, new_content):
    start, end, lines = find_section(body, heading)
    new_lines = new_content.splitlines()
    if new_lines and heading_depth(new_lines[0]) is not None:
        replacement = new_lines
    else:
        # Keep the blank line that separates a heading from its content.
        pad = [] if (new_lines and not new_lines[0].strip()) else [""]
        replacement = [lines[start]] + pad + new_lines
    out = lines[:start] + replacement + lines[end:]
    return "\n".join(out).rstrip() + "\n"


def load_prose_lint():
    """prose-lint from this script's folder (installed or chezmoi source name), or None."""
    here = Path(__file__).resolve().parent
    for name in ("prose-lint", "executable_prose-lint"):
        path = here / name
        if path.is_file():
            loader = SourceFileLoader("prose_lint", str(path))
            spec = importlib.util.spec_from_loader("prose_lint", loader)
            assert spec is not None
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            return module
    return None


def check_prose(new_text, old_text):
    lint = load_prose_lint()
    if lint is None:
        print("gh-pr-body: prose-lint isn't next to this script, so the prose check was skipped", file=sys.stderr)
        return
    findings = lint.lint_markdown(new_text, baseline=old_text)
    if findings:
        sys.exit(
            "gh-pr-body: prose-lint flagged the new text. Fix it, or pass --no-lint "
            "for text you didn't write:\n" + lint.format_findings(findings, "body")
        )


def main():
    ap = argparse.ArgumentParser(
        description=__doc__.split("\n\n", 1)[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("num", type=pr_ref, help="PR number or GitHub PR URL")
    ap.add_argument("-R", "--repo", metavar="OWNER/REPO",
                    help="Repository for a PR number; needed outside a checkout")
    ap.add_argument("--section", help="Section heading line, e.g. '## Test plan'")
    ap.add_argument("--edit-file", metavar="PATH",
                    help="Replace body (or section) from this file; '-' for stdin")
    ap.add_argument("edit_stdin", nargs="?", default=None,
                    help="Use '-' as positional to read replacement from stdin")
    ap.add_argument("--no-lint", action="store_true",
                    help="Skip the prose-lint check on the replacement text")
    args = ap.parse_intermixed_args()
    if args.repo:
        os.environ["GH_REPO"] = args.repo
    try:
        run(args)
    except subprocess.CalledProcessError as e:
        sys.exit(
            f"gh-pr-body: `{' '.join(map(str, e.cmd[:4]))}` failed (exit {e.returncode}). "
            "Outside the repo's checkout, pass -R OWNER/REPO or the PR URL."
        )


def run(args):
    edit_source = args.edit_file or args.edit_stdin
    full_body = fetch_body(args.num)
    body, footer = split_footer(full_body)

    if not edit_source:
        if args.section:
            print(extract_section(body, args.section), end="")
        else:
            print(full_body)
        return

    new_text = sys.stdin.read() if edit_source == "-" else open(edit_source).read()
    if not args.no_lint:
        old_text = extract_section(body, args.section) if args.section else full_body
        check_prose(new_text, old_text)
    if args.section:
        new_body = replace_section(body, args.section, new_text)
    else:
        new_body = new_text

    # A replacement carrying its own footer wins over the fetched one.
    if split_footer(new_body)[1]:
        footer = ""

    push_body(args.num, join_footer(new_body, footer))
    label = f"#{args.num}" if isinstance(args.num, int) else args.num
    print(f"updated PR {label} (verified)", file=sys.stderr)


if __name__ == "__main__":
    main()
