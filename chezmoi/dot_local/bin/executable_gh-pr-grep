#!/usr/bin/env python3
"""gh-pr-grep — search the changed lines of open pull requests.

Usage:
    gh-pr-grep <regex> [--path GLOB ...] [--exclude GLOB ...] [-R OWNER/REPO]
                       [--side added|removed|both] [--limit N] [--max-line N] [--json]

Lists the open PRs and their changed files in one call, keeps the PRs that
touch a --path glob (every PR without --path), then fetches those PRs' diffs
in parallel. Prints each added (+) or removed (-) line that matches, with its
file and line number, grouped by PR. Use it to find in-flight work that
overlaps a change before filing a ticket or opening a PR.

Globs use fnmatch, where * also matches /, so '*.yml' covers every YAML file.
Generated files (dist/, node_modules/, *.map, *.min.js, *.min.css,
package-lock.json) are skipped, and so are changed lines over --max-line
characters, so vendored bundles don't flood the output. A PR with 100 or more
changed files is always fetched, because the file list stops at 100.

Exit status: 0 when a line matched, 1 when none did, 2 on an error.

Examples:
    gh-pr-grep 'pip3? install|-m pip' --path '.github/*' --path 'scripts/*'
    gh-pr-grep 'build-requirements' -R OWNER/REPO --side added --json
"""

import argparse
import json
import re
import subprocess
import sys
from collections.abc import Iterator, Sequence
from concurrent.futures import ThreadPoolExecutor
from dataclasses import asdict, dataclass
from fnmatch import fnmatch
from typing import Any, Final

GENERATED: Final = ("dist/*", "*/dist/*", "node_modules/*", "*/node_modules/*", "*.map", "*.min.js", "*.min.css",
                    "package-lock.json", "*/package-lock.json")
LISTED_FILES: Final = 100  # gh pr list returns at most this many files per PR
HUNK: Final = re.compile(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@")
WORKERS: Final = 8


class GhError(Exception):
    """A gh command failed. The message is gh's own error output."""


@dataclass(frozen=True, slots=True)
class PullRequest:
    number: int
    title: str
    author: str
    draft: bool
    url: str
    paths: tuple[str, ...]


@dataclass(frozen=True, slots=True)
class Hit:
    pr: int
    path: str
    line: int
    side: str  # "+" for an added line, "-" for a removed one
    text: str


@dataclass(frozen=True, slots=True)
class Result:
    hits: list[Hit]
    long_lines: int  # changed lines too long to search
    error: str | None = None  # why the PR's diff couldn't be fetched


def gh(*args: str) -> str:
    result = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=300, check=False)
    if result.returncode != 0:
        raise GhError(result.stderr.strip() or f"`gh {' '.join(args)}` exited {result.returncode}")
    return result.stdout


def repo_args(repo: str | None) -> list[str]:
    return ["-R", repo] if repo else []


def open_pull_requests(repo: str | None, limit: int) -> list[PullRequest]:
    raw = json.loads(gh("pr", "list", *repo_args(repo), "--state", "open", "--limit", str(limit),
                        "--json", "number,title,author,isDraft,url,files"))
    return [PullRequest(int(pr["number"]), pr["title"], (pr.get("author") or {}).get("login", "ghost"),
                        bool(pr["isDraft"]), pr["url"], tuple(file["path"] for file in pr.get("files") or ()))
            for pr in raw]


def wanted(path: str, paths: Sequence[str], excludes: Sequence[str]) -> bool:
    if any(fnmatch(path, glob) for glob in excludes):
        return False
    return not paths or any(fnmatch(path, glob) for glob in paths)


def worth_fetching(pr: PullRequest, paths: Sequence[str], excludes: Sequence[str]) -> bool:
    return len(pr.paths) >= LISTED_FILES or any(wanted(path, paths, excludes) for path in pr.paths)


def changed_lines(diff: str) -> Iterator[tuple[str, int, str, str]]:
    """Yield (path, line, side, text) for each added or removed line of a unified diff.

    Added lines carry their line number in the new file, removed lines in the old one.
    The ---/+++ file headers are only read before a file's first hunk, so a removed
    line that starts with "--" isn't mistaken for one.
    """
    old_path = new_path = None
    path = ""
    old = new = 0
    in_header = False
    for raw in diff.split("\n"):
        if raw.startswith("diff --git "):
            in_header, old_path, new_path, path = True, None, None, ""
            continue
        if in_header:
            if raw.startswith("--- "):
                old_path = None if raw[4:] == "/dev/null" else raw[4:].removeprefix("a/")
            elif raw.startswith("+++ "):
                new_path = None if raw[4:] == "/dev/null" else raw[4:].removeprefix("b/")
                path = new_path or old_path or ""
            elif hunk := HUNK.match(raw):
                in_header, old, new = False, int(hunk[1]), int(hunk[2])
            continue
        if hunk := HUNK.match(raw):
            old, new = int(hunk[1]), int(hunk[2])
        elif raw.startswith("+"):
            yield path, new, "+", raw[1:]
            new += 1
        elif raw.startswith("-"):
            yield path, old, "-", raw[1:]
            old += 1
        elif raw.startswith(" "):
            old += 1
            new += 1


def search(pr: PullRequest, repo: str | None, pattern: re.Pattern[str], paths: Sequence[str],
           excludes: Sequence[str], sides: str, max_line: int) -> Result:
    """The matching lines in one PR's diff."""
    try:
        diff = gh("pr", "diff", str(pr.number), *repo_args(repo))
    except (GhError, subprocess.TimeoutExpired) as error:
        return Result([], 0, str(error).strip().splitlines()[-1] if str(error).strip() else type(error).__name__)
    hits: list[Hit] = []
    long_lines = 0
    for path, line, side, text in changed_lines(diff):
        if side not in sides or not wanted(path, paths, excludes):
            continue
        if len(text) > max_line:
            long_lines += 1
            continue
        if pattern.search(text):
            hits.append(Hit(pr.number, path, line, side, text.strip()))
    return Result(hits, long_lines)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("pattern", help="regular expression to find in added or removed lines")
    parser.add_argument("--path", action="append", default=[], metavar="GLOB",
                        help="only files matching this glob. Repeat for more")
    parser.add_argument("--exclude", action="append", default=[], metavar="GLOB",
                        help="skip files matching this glob, on top of the generated files. Repeat for more")
    parser.add_argument("-R", "--repo", help="OWNER/REPO, else the current directory's repository")
    parser.add_argument("--side", choices=("added", "removed", "both"), default="both",
                        help="which changed lines to search (default: both)")
    parser.add_argument("--limit", type=int, default=300, help="how many open PRs to consider, newest first (default: 300)")
    parser.add_argument("--max-line", type=int, default=400, help="skip changed lines longer than this (default: 400)")
    parser.add_argument("--json", action="store_true", help="print the matches as a JSON array")
    args = parser.parse_args()
    try:
        pattern = re.compile(args.pattern)
        excludes = (*GENERATED, *args.exclude)
        sides = {"added": "+", "removed": "-", "both": "+-"}[args.side]
        prs = open_pull_requests(args.repo, args.limit)
        candidates = [pr for pr in prs if worth_fetching(pr, args.path, excludes)]
        with ThreadPoolExecutor(max_workers=WORKERS) as pool:
            results = list(pool.map(lambda pr: search(pr, args.repo, pattern, args.path, excludes, sides, args.max_line),
                                    candidates))
    except re.error as error:
        parser.exit(2, f"gh-pr-grep: invalid pattern: {error}\n")
    except (GhError, subprocess.TimeoutExpired, OSError, json.JSONDecodeError, KeyError, TypeError) as error:
        parser.exit(2, f"gh-pr-grep: {error}\n")
    by_number = {pr.number: pr for pr in candidates}
    for pr, result in zip(candidates, results, strict=True):
        if result.error:
            print(f"gh-pr-grep: couldn't fetch the diff of #{pr.number}: {result.error}", file=sys.stderr)
    hits = [hit for result in results for hit in result.hits]
    long_lines = sum(result.long_lines for result in results)
    failed = sum(1 for result in results if result.error)
    summary = f"gh-pr-grep: searched {len(candidates) - failed} of {len(prs)} open PRs"
    if long_lines:
        summary += f", skipped {long_lines} changed line(s) over {args.max_line} characters"
    print(summary, file=sys.stderr)
    if args.json:
        rows: list[dict[str, Any]] = []
        for hit in hits:
            pr = by_number[hit.pr]
            rows.append({**asdict(hit), "title": pr.title, "author": pr.author, "draft": pr.draft, "url": pr.url})
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for number in sorted({hit.pr for hit in hits}, reverse=True):
            pr = by_number[number]
            print(f"#{pr.number} {pr.title} ({pr.author}{', draft' if pr.draft else ''})")
            for hit in (hit for hit in hits if hit.pr == number):
                print(f"  {hit.path}:{hit.line} {hit.side} {hit.text}")
    sys.exit(0 if hits else 1)


if __name__ == "__main__":
    main()
