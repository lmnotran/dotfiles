#!/usr/bin/env python3
"""Find GitHub Actions log permalinks for lines in a job's log, or the line a permalink points at.

Requires gh authentication, a completed job, and unexpired logs. A job URL supplies
its repository; numeric IDs use --repo, GH_REPO, or the current gh repository context.
Uses the run attempt's per-step ZIP logs when the archive has them. Otherwise, or
while the rest of the run is still going and the archive doesn't exist yet, it
splits the job log by the API's whole-second step times and each step's first
line, and skips matching lines whose step it can't pin down. Line numbers count
every line of the step's log, including the ##[endgroup] and ##[end-action] lines
the log viewer hides, because that's how GitHub resolves #step:N:L links. The
number the viewer shows next to a line can be lower.

It skips the header the runner prints at the top of each step and composite step:
a run step's script, a uses step's inputs, and the shell and env lines. So a
pattern for what a script prints finds the output, not the echo command that
prints it. --include-header matches in headers too.

With --run, the job argument is a regular expression for a job's name in that
run's latest attempt, like "unittest-ci-scripts" for "Build / trigger_unit_test /
unittest-ci-scripts". It must match exactly one job. --text prints each link with
the line it points at. Transient GitHub errors (an HTTP/2 stream error, a 502,
503, or 504, or a reset connection) are retried twice before giving up.

--show goes the other way: it prints the line each #step:N:L link lands on, the way
--text prints a match, so you can check the links in a draft before posting it. It
reads each job's logs once, reports a link it can't resolve, and goes on to the
next one.
"""

import argparse
import io
import json
import re
import subprocess
import sys
import time
from bisect import bisect_left, bisect_right
from dataclasses import dataclass
from itertools import pairwise
from typing import Any, Final
from urllib.parse import urlsplit
from zipfile import BadZipFile, ZipFile

STAMPED_LINE: Final = re.compile(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.\d+)?Z ?(.*)")
ANSI_ESCAPE: Final = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
RUNNER_STEPS: Final = frozenset({"Complete job", "Initialize containers", "Stop containers"})
PREPARE_ACTIONS: Final = "Prepare all required actions"
# What the runner prints between PREPARE_ACTIONS and the Run line of a step that runs a
# local action (actions/runner's ActionManager.cs).
PREPARE_DETAILS: Final = ("Getting action download info", "Download action repository ",
                          "##[group]Download immutable action package ", "Version: ", "Digest: ",
                          "Source commit SHA: ", "##[endgroup]", "##[debug]")
RUN_HEADER: Final = "##[group]Run "
# gh's error output for failures worth another try, like "stream error: stream ID 1; CANCEL;
# received from peer" when GitHub drops an HTTP/2 stream mid-download.
TRANSIENT_ERROR: Final = re.compile(r"stream error|connection reset|unexpected EOF|i/o timeout|"
                                    r"TLS handshake timeout|HTTP 50[234]")
RETRY_DELAYS: Final = (2.0, 5.0)
JOBS_PER_PAGE: Final = 100
NO_MATCH: Final = re.compile(r"(?!)")
STEP_ANCHOR: Final = re.compile(r"step:(\d+):([1-9]\d*)")


class AnchorError(Exception):
    """The available input cannot identify an unambiguous log anchor."""


class StepLogsMissing(AnchorError):
    """The run's log archive has no per-step files for this job."""


class ApiError(Exception):
    """`gh api` failed. The message is gh's own error output."""


@dataclass(frozen=True, slots=True)
class Job:
    run_id: int
    attempt: int
    url: str
    steps: frozenset[int]


@dataclass(frozen=True, slots=True)
class Step:
    number: int
    name: str
    started: str  # whole UTC second, YYYY-MM-DDTHH:MM:SS
    completed: str


def gh_once(endpoint: str) -> bytes:
    result = subprocess.run(["gh", "api", endpoint], capture_output=True, timeout=120, check=False)
    if result.returncode != 0:
        message = result.stderr.decode("utf-8", "replace").strip()
        raise ApiError(message or f"`gh api {endpoint}` exited {result.returncode}")
    return result.stdout


def gh(endpoint: str) -> bytes:
    for delay in RETRY_DELAYS:
        try:
            return gh_once(endpoint)
        except ApiError as error:
            if not TRANSIENT_ERROR.search(str(error)):
                raise
            print(f"gh-step-anchor: retrying in {delay:g}s after: {str(error).splitlines()[-1]}", file=sys.stderr)
            time.sleep(delay)
    return gh_once(endpoint)


def api_repo(repo: str | None) -> str:
    if repo and not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
        raise AnchorError("--repo must be OWNER/REPO")
    return f"repos/{repo or '{owner}/{repo}'}"


def job_target(value: str, repo: str | None) -> tuple[str, str]:
    if value.isdecimal():
        return api_repo(repo), value
    url = urlsplit(value)
    match = re.fullmatch(r"/([\w.-]+/[\w.-]+)/actions/runs/\d+/job/(\d+)/?", url.path)
    if url.scheme != "https" or url.netloc != "github.com" or not match:
        raise AnchorError("expected a numeric job ID or https://github.com/OWNER/REPO/actions/runs/RUN/job/JOB URL")
    if repo and repo.lower() != match[1].lower():
        raise AnchorError("--repo conflicts with the job URL's repository")
    return f"repos/{match[1]}", match[2]


def anchor_target(value: str, repo: str | None) -> tuple[str, str, int, int]:
    """The repository, job ID, step and line of a job URL ending in #step:N:L."""
    match = STEP_ANCHOR.fullmatch(urlsplit(value).fragment)
    if value.isdecimal() or not match:
        raise AnchorError("--show expects https://github.com/OWNER/REPO/actions/runs/RUN/job/JOB#step:N:L links")
    api, job_id = job_target(value, repo)
    return api, job_id, int(match[1]), int(match[2])


def run_target(value: str, repo: str | None) -> tuple[str, str]:
    if value.isdecimal():
        return api_repo(repo), value
    url = urlsplit(value)
    match = re.fullmatch(r"/([\w.-]+/[\w.-]+)/actions/runs/(\d+)(?:/attempts/\d+)?/?", url.path)
    if url.scheme != "https" or url.netloc != "github.com" or not match:
        raise AnchorError("--run expects a numeric run ID or https://github.com/OWNER/REPO/actions/runs/RUN URL")
    if repo and repo.lower() != match[1].lower():
        raise AnchorError("--repo conflicts with the run URL's repository")
    return f"repos/{match[1]}", match[2]


def find_job(repo: str, run_id: str, name: re.Pattern[str]) -> str:
    """The ID of the one job in the run's latest attempt whose name the pattern matches."""
    jobs: list[dict[str, Any]] = []
    for page in range(1, 100):
        batch = json.loads(gh(f"{repo}/actions/runs/{run_id}/jobs?filter=latest&per_page={JOBS_PER_PAGE}&page={page}"))["jobs"]
        jobs += batch
        if len(batch) < JOBS_PER_PAGE:
            break
    found = [job for job in jobs if name.search(job["name"])]
    if len(found) == 1:
        return str(found[0]["id"])
    if not found:
        raise AnchorError(f"no job in run {run_id} matches {name.pattern!r}")
    names = "; ".join(job["name"] for job in found)
    raise AnchorError(f"{len(found)} jobs in run {run_id} match {name.pattern!r}, narrow the pattern: {names}")


def shown_text(line: str) -> str:
    """The log line without GitHub's timestamp, for --text output."""
    stamped = STAMPED_LINE.match(line)
    return stamped[2] if stamped else line


def log_lines(text: str) -> list[str]:
    # GitHub's #step:N:L links count every physical line, including the ##[endgroup] and
    # ##[end-action] lines its log viewer hides and leaves out of the numbers it shows.
    lines = text.lstrip("\ufeff").replace("\r\n", "\n").split("\n")
    return lines[:-1] if lines[-1] == "" else lines


def line_matches(pattern: re.Pattern[str], line: str) -> bool:
    """Whether the pattern matches the line, or the line's text after GitHub's timestamp.

    ANSI color codes are removed first: tools like pytest color parts of a line, so
    "43 passed, 262 deselected" has escape codes between its words in the raw log.
    """
    plain = ANSI_ESCAPE.sub("", line)
    if pattern.search(plain):
        return True
    stamped = STAMPED_LINE.match(plain)
    return bool(stamped and pattern.search(stamped[2]))


def step_logs(archive: ZipFile, job_log: str) -> list[tuple[int, list[str]]]:
    expected = log_lines(job_log)
    folders = []
    for member in archive.infolist():
        match = re.fullmatch(r"-?\d+_([^/]+)\.txt", member.filename)
        if match and log_lines(archive.read(member).decode("utf-8-sig")) == expected:
            folders.append(match[1])
    if len(folders) != 1:
        raise AnchorError(f"expected one matching job log in the archive, found {len(folders)}; refusing to guess")
    matcher = re.compile(rf"{re.escape(folders[0])}/(\d+)_[^/]+\.txt")
    result = []
    seen = set()
    for member in archive.infolist():
        match = matcher.fullmatch(member.filename)
        if not match:
            continue
        number = int(match[1])
        if number in seen:
            raise AnchorError(f"multiple log files for step {number}; refusing to guess")
        seen.add(number)
        result.append((number, log_lines(archive.read(member).decode("utf-8-sig"))))
    if not result:
        raise StepLogsMissing("per-step logs are unavailable; cannot produce a reliable line anchor")
    return sorted(result)


def opens_step(name: str, text: str) -> bool:
    """Whether a top-level log line can be the first line of the named step."""
    if name in RUNNER_STEPS or name.startswith("Pre "):
        return False
    if name.startswith("Post "):
        return text == "Post job cleanup."
    return text.startswith("##[group]Run ") or text == PREPARE_ACTIONS


def split_job_log(lines: list[str], steps: tuple[Step, ...]) -> list[tuple[int, list[str]]]:
    """Return the lines each step certainly owns, given the steps that wrote to the log.

    A step starts at a line stamped in its start second, or at the first line after the
    previous step's end second. Of those, it must start at a line that opens_step accepts,
    outside composite actions' start-action/end-action markers. A step that runs a local
    action starts where the runner prepares its actions, and the Run line after that
    preparation belongs to the same step. A step that matches no such line could start
    at any of them. Steps whose start isn't unique are left out.
    """
    if not lines or not steps:
        return []
    seconds: list[str] = []
    openers: list[str | None] = []
    second, depth, preparing = "", 0, False
    for line in lines:
        match = STAMPED_LINE.match(line)
        second, text = (match[1], match[2]) if match else (second, line)
        if text.startswith("##[end-action"):
            depth = max(depth - 1, 0)
        seconds.append(second)
        prepared_run = preparing and text.startswith("##[group]Run ")
        openers.append(text if depth == 0 and not prepared_run else None)
        preparing = depth == 0 and (text == PREPARE_ACTIONS or (preparing and text.startswith(PREPARE_DETAILS)))
        if text.startswith("##[start-action"):
            depth += 1
    if seconds != sorted(seconds):
        raise AnchorError("job log timestamps are out of order; refusing to guess")
    options = [[0]]
    for previous, step in pairwise(steps):
        window = range(bisect_left(seconds, step.started),
                       min(bisect_right(seconds, previous.completed), len(lines) - 1) + 1)
        options.append([index for index in window if (text := openers[index]) is not None
                        and opens_step(step.name, text)] or list(window))
    forward: list[list[int]] = []
    floor = -1
    for choices in options:
        forward.append([index for index in choices if index > floor])
        floor = forward[-1][0] if forward[-1] else len(lines)
    feasible: list[list[int]] = []
    ceiling = len(lines)
    for choices in reversed(forward):
        feasible.insert(0, [index for index in choices if index < ceiling])
        ceiling = feasible[0][-1] if feasible[0] else -1
    if not all(feasible):
        raise AnchorError("job log doesn't fit the job's step times; refusing to guess")
    ends = [choices[0] for choices in feasible[1:]] + [len(lines)]
    return [(step.number, lines[choices[0]:end])
            for step, choices, end in zip(steps, feasible, ends, strict=True) if len(choices) == 1]


def split_by_step_times(job_log: str, steps: list[dict[str, Any]], pattern: re.Pattern[str]) -> list[tuple[int, list[str]]]:
    """split_job_log on the job's own log, noting matching lines it couldn't place."""
    lines = log_lines(job_log)
    logs = split_job_log(lines, tuple(
        Step(int(step["number"]), step["name"], step["started_at"][:19], step["completed_at"][:19])
        for step in steps
        if step["conclusion"] != "skipped" and step["started_at"] and step["completed_at"]))
    placed = sum(line_matches(pattern, line) for _, step_lines in logs for line in step_lines)
    skipped = sum(line_matches(pattern, line) for line in lines) - placed
    if skipped:
        print(f"gh-step-anchor: skipped {skipped} matching line(s) it can't place in a step", file=sys.stderr)
    return logs


def resolve_step_logs(archive: ZipFile | None, job_log: str, steps: list[dict[str, Any]],
                      pattern: re.Pattern[str]) -> list[tuple[int, list[str]]]:
    if archive is None:
        return split_by_step_times(job_log, steps, pattern)
    try:
        return step_logs(archive, job_log)
    except StepLogsMissing:
        return split_by_step_times(job_log, steps, pattern)


def fetch_job(repo: str, job_id: str) -> tuple[Job, list[dict[str, Any]]]:
    """The job and its steps from the API. The job must be completed."""
    raw = json.loads(gh(f"{repo}/actions/jobs/{job_id}"))
    if raw["status"] != "completed":
        raise AnchorError("job must be completed before its step logs can be downloaded")
    job = Job(int(raw["run_id"]), int(raw["run_attempt"]), raw["html_url"],
              frozenset(int(step["number"]) for step in raw["steps"]))
    return job, raw["steps"]


def fetch_step_logs(repo: str, job_id: str, job: Job, steps: list[dict[str, Any]],
                    pattern: re.Pattern[str]) -> list[tuple[int, list[str]]]:
    """Each step's lines, from the run's per-step logs or else the job log split by step times."""
    job_log = gh(f"{repo}/actions/jobs/{job_id}/logs").decode("utf-8-sig")
    try:
        archive = gh(f"{repo}/actions/runs/{job.run_id}/attempts/{job.attempt}/logs")
    except ApiError as error:
        if "HTTP 404" not in str(error):
            raise
        print("gh-step-anchor: the run's log archive isn't there until the whole run finishes, "
              "so this splits the job log by step times", file=sys.stderr)
        logs = resolve_step_logs(None, job_log, steps, pattern)
    else:
        with ZipFile(io.BytesIO(archive)) as zip_file:
            logs = resolve_step_logs(zip_file, job_log, steps, pattern)
    if any(number not in job.steps for number, _ in logs):
        raise AnchorError("archive step numbers disagree with job metadata; refusing to guess")
    return logs


def show_lines(links: list[str], repo: str | None) -> tuple[list[dict[str, Any]], list[str]]:
    """The line each #step:N:L link lands on, and an error for each link that doesn't resolve."""
    jobs: dict[tuple[str, str], tuple[Job, dict[int, list[str]]]] = {}
    shown: list[dict[str, Any]] = []
    errors: list[str] = []
    for link in links:
        try:
            api, job_id, step, line = anchor_target(link, repo)
            if (api, job_id) not in jobs:
                job, steps = fetch_job(api, job_id)
                jobs[api, job_id] = job, dict(fetch_step_logs(api, job_id, job, steps, NO_MATCH))
            job, logs = jobs[api, job_id]
            if step not in job.steps:
                raise AnchorError(f"step {step} is not in this job")
            if step not in logs:
                raise AnchorError(f"can't tell which log lines belong to step {step}; refusing to guess")
            if line > len(logs[step]):
                raise AnchorError(f"step {step}'s log has {len(logs[step])} lines, so line {line} doesn't exist")
            shown.append({"step": step, "line": line, "text": ANSI_ESCAPE.sub("", logs[step][line - 1]), "url": link})
        except (AnchorError, ApiError, BadZipFile, UnicodeDecodeError, json.JSONDecodeError, KeyError, TypeError,
                ValueError, subprocess.TimeoutExpired, OSError) as error:
            errors.append(f"{link}: {error}")
    return shown, errors


def step_headers(lines: list[str]) -> set[int]:
    """Indexes of the lines in a step's headers: each "##[group]Run ..." group through its ##[endgroup].

    A header opens the step, after any action preparation, or follows a composite step's
    start-action marker. A "Run ..." group the step's own output opens is not a header, and
    neither is one that never closes.
    """
    texts = [match[2] if (match := STAMPED_LINE.match(line)) else line for line in lines]
    headers: set[int] = set()
    may_open = True
    index = 0
    while index < len(texts):
        text = texts[index]
        if may_open and text.startswith(RUN_HEADER):
            end = next((later for later in range(index + 1, len(texts)) if texts[later].startswith("##[endgroup]")), None)
            if end is None:
                break
            headers.update(range(index, end + 1))
            index, may_open = end + 1, False
            continue
        may_open = text.startswith("##[start-action") or (
            may_open and (text == PREPARE_ACTIONS or text.startswith(PREPARE_DETAILS)))
        index += 1
    return headers


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("job", nargs="?", help="job ID or GitHub Actions job URL. With --run, a regular expression "
                                               "for the job's name")
    parser.add_argument("pattern", nargs="?", help="regular expression to find in the log. Each line is tried with "
                                                   "and without GitHub's leading timestamp, so ^ anchors to the log "
                                                   "text. ANSI color codes are removed before matching")
    parser.add_argument("-R", "--repo", help="OWNER/REPO for a numeric job or run ID")
    parser.add_argument("--run", help="run ID or run URL. Finds the job by name in the run's latest attempt")
    parser.add_argument("--step", type=int, help="restrict to this API/UI step number")
    parser.add_argument("--all", action="store_true", help="print every matching line, not just the first")
    parser.add_argument("--show", nargs="+", metavar="LINK",
                        help="print the line each https://github.com/OWNER/REPO/actions/runs/RUN/job/JOB#step:N:L "
                             "link lands on, instead of searching. Takes no job or pattern")
    output = parser.add_mutually_exclusive_group()
    output.add_argument("--json", action="store_true", help="emit matches with step, line, text and URL")
    output.add_argument("--text", action="store_true",
                        help="print each URL with the line it points at, without the timestamp")
    parser.add_argument("--include-header", action="store_true",
                        help="also match in step headers: a run step's script, a uses step's inputs, and the "
                             "shell and env lines the runner prints above a step's output")
    args = parser.parse_args()
    if args.show:
        if (args.job, args.pattern, args.run, args.step) != (None, None, None, None) or args.all or args.include_header:
            parser.error("--show takes only links, plus --repo, --json or --text")
        shown, errors = show_lines(args.show, args.repo)
        if args.json:
            print(json.dumps(shown, ensure_ascii=False, indent=2))
        else:
            for found in shown:
                print(f"{found['url']}  {shown_text(found['text'])}")
        if errors:
            parser.exit(1, "".join(f"gh-step-anchor: {error}\n" for error in errors))
        return
    if args.job is None or args.pattern is None:
        parser.error("the following arguments are required: job, pattern (or --show LINK)")
    try:
        pattern = re.compile(args.pattern)
        if args.run:
            repo, run_id = run_target(args.run, args.repo)
            job_id = find_job(repo, run_id, re.compile(args.job))
        else:
            repo, job_id = job_target(args.job, args.repo)
        job, steps = fetch_job(repo, job_id)
        if args.step is not None and args.step not in job.steps:
            raise AnchorError(f"step {args.step} is not in this job")
        logs = fetch_step_logs(repo, job_id, job, steps, pattern)
        matches: list[dict[str, Any]] = []
        header_matches = 0
        for number, lines in logs:
            if args.step is not None and number != args.step:
                continue
            headers = set() if args.include_header else step_headers(lines)
            for line_number, line in enumerate(lines, 1):
                if not line_matches(pattern, line):
                    continue
                if line_number - 1 in headers:
                    header_matches += 1
                    continue
                matches.append({"step": number, "line": line_number, "text": ANSI_ESCAPE.sub("", line),
                                "url": f"{job.url.split('#')[0]}#step:{number}:{line_number}"})
                if not args.all:
                    break
            if matches and not args.all:
                break
        if not matches and header_matches:
            raise AnchorError("pattern only matched in step headers, the script or inputs the runner prints above "
                              f"a step's output. Pass --include-header to match there: {args.pattern}")
        if not matches:
            raise AnchorError(f"pattern not matched in available step logs: {args.pattern}")
        if args.json:
            print(json.dumps(matches, ensure_ascii=False, indent=2))
        elif args.text:
            for match in matches:
                print(f"{match['url']}  {shown_text(match['text'])}")
        else:
            for match in matches:
                print(match["url"])
    except (AnchorError, re.error, BadZipFile, UnicodeDecodeError,
            json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
        parser.exit(1, f"gh-step-anchor: {error}\n")
    except (ApiError, subprocess.TimeoutExpired, OSError) as error:
        parser.exit(1, f"gh-step-anchor: unable to fetch logs: {error}\n")


if __name__ == "__main__":
    main()
