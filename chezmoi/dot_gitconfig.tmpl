[user]
	name = "Mason Tran"
{{- $userHost := printf "%s@%s" .chezmoi.username .chezmoi.hostname -}}
{{- $isWork := or (hasPrefix "usmastra" .chezmoi.username) (has $userHost .work.knownUserHosts) -}}
{{- /* The work email lives in the private lmnotran/work-dotfiles, cloned by run_before_10-clone-work-dotfiles. */ -}}
{{- $workGitConfig := joinPath .chezmoi.homeDir "repos" "work-dotfiles" "git" "config" -}}
{{- $email := "mason@Lmnotran.com" -}}
{{- if and $isWork (stat $workGitConfig) }}
{{- $email = output "git" "config" "--file" $workGitConfig "user.email" | trim -}}
{{- end }}
	email = "{{ $email }}"
{{- if lookPath "gpg" -}}
{{-   $signingKey := output "sh" "-c" (printf "gpg --list-keys --keyid-format long --with-colons '%s' 2>/dev/null || true" $email) | regexFind "[A-F0-9]{16}" -}}
{{-   if $signingKey }}
	signingkey = {{ $signingKey }}
{{-   end -}}
{{- end }}
[commit]
	gpgsign = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- /* Same entries `gh auth setup-git` writes. The empty helper clears inherited helpers. */}}
{{- $gh := lookPath "gh" }}
{{- if $gh }}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{- end }}
{{- /* Repo owned by the separate "mason" account on the work Mac. */}}
{{- if stat "/Users/mason/code/monarch-mcp-server" }}
[safe]
	directory = /Users/mason/code/monarch-mcp-server
{{- end }}
