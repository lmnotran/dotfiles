#!/bin/bash
#
# install-deps - Install external dependencies for dotfiles
#
# Usage: ./install-deps [--dry-run]
#
# Strategy:
#   - Linux: Use apt for packages available in repos, brew for extras (lazygit, pyenv)
#   - macOS: Use brew for everything
#
set -euo pipefail

DRY_RUN=false
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
# Define packages per package manager
# ─────────────────────────────────────────────────────────────────────────────

# Packages available via apt (Linux)
DEPS_APT=(
    build-essential
    cmake
    coreutils
    curl
    fd-find
    fzf
    git
    git-lfs
    htop
    jq
    make
    neovim
    ninja-build
    ripgrep
    stow
    sudo
    tmux
    unzip
    wget
    zsh
)

# Packages only available via brew (used on Linux for extras, macOS adds these too)
DEPS_BREW_EXTRAS=(
    bitwarden-cli
    lazygit
    pyenv
)

# Base brew packages for macOS (DEPS_BREW_EXTRAS appended at install time)
DEPS_BREW_BASE=(
    coreutils
    curl
    fd
    fzf
    git
    git-lfs
    grep
    htop
    jq
    make
    neovim
    openjdk@11
    ripgrep
    stow
    tmux
    wget
    zsh
)

# ─────────────────────────────────────────────────────────────────────────────
# Colors
# ─────────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    DIM='\033[2m'
    RESET='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' DIM='' RESET=''
fi
export RED GREEN YELLOW BLUE CYAN BOLD DIM RESET

# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

log()  { echo -e "${CYAN}[install-deps]${RESET} $*"; }
warn() { echo -e "${YELLOW}[install-deps] WARNING:${RESET} $*" >&2; }
err()  { echo -e "${RED}[install-deps] ERROR:${RESET} $*" >&2; exit 1; }

command_exists() { command -v "$1" &>/dev/null; }

run() {
    if $DRY_RUN; then
        log "(dry-run) $*"
    else
        "$@"
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Installation functions
# ─────────────────────────────────────────────────────────────────────────────

install_homebrew() {
    if command_exists brew; then
        log "Homebrew already installed"
        return
    fi

    log "Installing Homebrew..."
    if $DRY_RUN; then
        log "(dry-run) Would install Homebrew"
    else
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        # Add brew to PATH for this session
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi
}

install_linux() {
    log "Installing packages via apt..."
    run sudo apt-get update
    run sudo apt-get install -y --no-install-recommends "${DEPS_APT[@]}"

    # Install extras via brew (lazygit, pyenv, etc.)
    log "Installing extras via brew..."
    install_homebrew
    run brew install "${DEPS_BREW_EXTRAS[@]}"
}

install_macos() {
    log "Installing packages via brew..."
    install_homebrew
    run brew install "${DEPS_BREW_BASE[@]}" "${DEPS_BREW_EXTRAS[@]}"

    # Python deps for macOS-only tooling (e.g. AppKit clipboard writes
    # used by Copilot CLI's ask-team-for-pr-review procedure).
    log "Installing macOS-only Python deps..."
    run pip3 install --user --quiet pyobjc-framework-Cocoa
}

install_antidote() {
    local antidote_home="${XDG_DATA_HOME:-$HOME/.local/share}/antidote"
    if [[ -d "$antidote_home" ]]; then
        log "Antidote already installed"
        return
    fi
    log "Installing antidote (zsh plugin manager)..."
    run git clone --depth=1 https://github.com/mattmc3/antidote.git "$antidote_home"
}

install_tmux_framework() {
    local tmux_home="$HOME/.tmux"
    if [[ -d "$tmux_home" ]]; then
        log "gpakosz/.tmux already installed"
        return
    fi
    log "Installing gpakosz/.tmux..."
    run git clone --depth=1 https://github.com/gpakosz/.tmux.git "$tmux_home"
}

setup_work_user_access() {
    local personal_user="mason"
    local work_user="usmastra"
    local shared_group="sharedwork"
    local work_home="/Users/$work_user"
    local sudoers_file="/etc/sudoers.d/work-user"

    # Only relevant on macOS when both users exist
    if [[ "$OSTYPE" != "darwin"* ]]; then
        return
    fi
    if ! id "$work_user" &>/dev/null; then
        log "Work user '$work_user' not found, skipping work-user access setup"
        return
    fi
    if [[ "$(whoami)" != "$personal_user" ]]; then
        return
    fi

    # --- Sudoers rule ---
    if [[ -f "$sudoers_file" ]]; then
        log "Work-user sudoers rule already configured"
    else
        log "Configuring sudoers for '$personal_user' to switch to '$work_user'..."
        if $DRY_RUN; then
            log "(dry-run) Would create $sudoers_file"
        else
            printf '%s ALL=(%s) NOPASSWD: ALL\n' "$personal_user" "$work_user" \
                | sudo tee "$sudoers_file" >/dev/null
            sudo chmod 0440 "$sudoers_file"
            if sudo visudo -cf "$sudoers_file"; then
                log "${GREEN}✓${RESET} Created $sudoers_file"
            else
                sudo rm -f "$sudoers_file"
                warn "Invalid sudoers syntax, removed $sudoers_file"
            fi
        fi
    fi

    # --- Shared group for cross-user file access ---
    if dseditgroup -o checkmember -m "$personal_user" "$shared_group" &>/dev/null; then
        log "Shared group '$shared_group' already configured"
    else
        log "Setting up shared group '$shared_group'..."
        if $DRY_RUN; then
            log "(dry-run) Would create group '$shared_group' and add '$personal_user'"
        else
            # Create group if it doesn't exist
            if ! dseditgroup -o read "$shared_group" &>/dev/null; then
                sudo dseditgroup -o create "$shared_group"
                log "Created group '$shared_group'"
            fi
            # Add both users to the group
            sudo dseditgroup -o edit -a "$personal_user" -t user "$shared_group"
            sudo dseditgroup -o edit -a "$work_user" -t user "$shared_group"
            log "${GREEN}✓${RESET} Added '$personal_user' and '$work_user' to '$shared_group'"
        fi
    fi

    # --- Set group ownership on work home directory ---
    if [[ -d "$work_home" ]]; then
        # Directories to skip (macOS system/app-managed folders)
        local -a skip_dirs=(
            Library
            Desktop
            Documents
            Downloads
            Pictures
            Music
            Movies
            Public
            Applications
            .Trash
        )

        local current_group
        current_group="$(stat -f '%Sg' "$work_home")"
        if [[ "$current_group" == "$shared_group" ]]; then
            log "Group ownership on $work_home already set"
        else
            log "Setting group ownership on $work_home..."
            if $DRY_RUN; then
                log "(dry-run) Would chgrp/chmod $work_home (skipping: ${skip_dirs[*]})"
            else
                # Set group on the home directory itself
                sudo chgrp "$shared_group" "$work_home"
                sudo chmod g+rwX "$work_home"

                # Recursively set group on everything except skipped dirs
                local find_args=()
                for d in "${skip_dirs[@]}"; do
                    find_args+=(-path "$work_home/$d" -prune -o)
                done

                sudo find "$work_home" "${find_args[@]}" -print0 \
                    | sudo xargs -0 chgrp "$shared_group"
                sudo find "$work_home" "${find_args[@]}" -print0 \
                    | sudo xargs -0 chmod g+rwX

                log "${GREEN}✓${RESET} Set '$shared_group' group ownership on $work_home (skipped: ${skip_dirs[*]})"
            fi
        fi
    fi
}

set_default_shell() {
    if [[ "$SHELL" == *"zsh"* ]]; then
        log "zsh is already the default shell"
        return
    fi

    # Skip in containers or non-interactive environments
    if [[ -f /.dockerenv ]] || [[ -n "${REMOTE_CONTAINERS:-}" ]] || [[ -n "${CODESPACES:-}" ]]; then
        log "Skipping chsh in container environment"
        return
    fi

    log "Setting zsh as default shell..."
    if $DRY_RUN; then
        log "(dry-run) Would run: chsh -s $(which zsh)"
    else
        # Use sudo chsh to avoid password prompt if possible
        if sudo -n true 2>/dev/null; then
            sudo chsh -s "$(which zsh)" "$USER" || warn "Failed to change shell"
        else
            warn "Skipping chsh (requires password). Run manually: chsh -s \$(which zsh)"
        fi
    fi
}

init_submodules() {
    log "Initializing git submodules..."
    local script_dir repo_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    repo_dir="$(dirname "$script_dir")"
    run git -C "$repo_dir" submodule update --init --recursive
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

main() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        install_macos
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        install_linux
    else
        err "Unsupported OS: $OSTYPE"
    fi

    install_antidote
    install_tmux_framework
    set_default_shell
    setup_work_user_access

    log "${GREEN}✓${RESET} Dependencies installed!"
}

main "$@"
